    <div id="internship" style="display:none; padding: 20px; background-color: #f4f4f4; color: #333;">
        <h1>Shop at Poorvika</h1>
        <p>Experience the New Way of Shopping from Poorvika, India's No1 Tech Retailer. Grab All your Electronic needs at the Best Price Online Today!</p>
        <a href="index.html" class="cta">Back to Home</a>
    </div>

    <script>
       
        document.querySelectorAll('a[href]').forEach(link => {
            link.addEventListener('click', event => {
                event.preventDefault();
                const target = event.target.getAttribute('href').replace('.html', '');

                document.querySelectorAll('div[id]').forEach(page => {
                    page.style.display = page.id === target ? 'block' : 'none';
                });
            });
        });
    </script>
</body>
</html>
